      "label": "Detector CLI",
      "sublabel": "ai_code_detector.py main",
      "row": 0,
      "col": 0
    },
    {
      "id": "scanner",
      "type": "frontend",
      "label": "Repo scanner CLI",
      "sublabel": "github_repo_scanner.py",
      "row": 0,
      "col": 1
    },
    {
      "id": "detector",
      "type": "backend",
      "label": "AICodeDetector",
      "sublabel": "dimension analyzers",
      "row": 1,
      "col": 0
    },
    {
      "id": "reports",
      "type": "backend",
      "label": "ReportGenerator",
      "sublabel": "report_generator.py",
      "row": 1,
      "col": 1
    },
    {
      "id": "files",
